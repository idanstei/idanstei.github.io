{% comment %}
  Site-specific Selected Publications renderer.
  resume.json is already ordered newest-to-oldest, including year-only dates.
{% endcomment %}

<ul class="card-text font-weight-light list-group list-group-flush" style="list-style: none; padding-left: 0">
  {% for entry in entries %}
    {% unless entry.name contains 'Full List on Google Scholar' %}
      <li class="list-group-item cv-publication-item">
        <div class="row">
          <div class="col-xs-2 col-sm-2 col-md-2 text-center date-column cv-publication-date">
            {% assign pub_year = entry.releaseDate | append: '' | split: '-' | first | strip %}
            {% if pub_year != '' %}
              <span class="badge font-weight-bold danger-color-dark text-uppercase align-middle" style="min-width: 75px">
                {{ pub_year }}
              </span>
            {% endif %}
          </div>

          <div class="col-xs-10 col-sm-10 col-md-10 mt-2 mt-md-0">
            {% if entry.name %}
              <h6 class="title font-weight-bold ml-1 ml-md-4">
                {% if entry.url %}
                  <a href="{{ entry.url }}" target="_blank" rel="noopener noreferrer">{{ entry.name }}</a>
                {% else %}
                  {{ entry.name }}
                {% endif %}
              </h6>
            {% endif %}

            {% if entry.publisher %}
              <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem; font-style: italic">{{ entry.publisher }}</h6>
            {% endif %}
          </div>
        </div>
      </li>
    {% endunless %}
  {% endfor %}
</ul>
